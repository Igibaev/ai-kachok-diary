# ============================================================
#  FitCoach AI — конфигурация бренда (white-label)
#  Один файл = один клиент. Имя файла (без .properties) — имя flavor
#  и имя папки с ресурсами клиента: app/src/<имя>/res, app/src/<имя>/assets.
#  Имя: только латиница/цифры, начинается с буквы: demo, ironclub, fitpalace.
# ============================================================

# --- Приложение ---------------------------------------------------------------
appName=Название клуба
applicationId=kz.clubname.app
versionName=1.0.0
# Короткое имя бренда внутри приложения (заголовки, карточки шаринга)
brandName=Название клуба
# Имя AI-тренера, как он представляется в чате
aiCoachName=Коуч
defaultLanguage=ru

# --- Клуб (вкладка «Клуб», карточки шаринга, промпт AI) ------------------------
clubName=Название клуба
clubCity=Алматы
clubAddress=пр. Абая 150/230, Алматы
clubHours=Пн–Пт 07:00–23:00 · Сб–Вс 09:00–22:00
clubPhone=+7 700 123 45 67
# WhatsApp: только цифры с кодом страны
clubWhatsapp=77001234567
# Instagram без @
clubInstagram=clubname
clubMapUrl=https://2gis.kz/almaty
clubWebsite=https://fitcoach.example
# Ссылки на удалённые JSON (опционально). Пусто → берутся файлы из assets/club/.
clubDataUrl=
newsUrl=

# --- Цвета (HEX, #RRGGBB) ------------------------------------------------------
accentColor=#C8FF00
accentOnColor=#0D0D0D
backgroundColor=#0D0D0D
surfaceColor=#141414
cardColor=#1C1C1C

# --- AI ---------------------------------------------------------------------------
# URL Cloudflare Worker из папки proxy/. Пусто → приложение работает в демо-режиме
# (офлайн-ответы) или с ключом разработчика из настроек.
aiProxyUrl=
aiProxyToken=
aiModel=claude-opus-5
