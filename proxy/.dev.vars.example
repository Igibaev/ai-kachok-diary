# Скопируйте в .dev.vars для локального запуска (wrangler dev). Файл .dev.vars в git не попадает.
APP_TOKEN=change-me-long-random-string
# Провайдер по умолчанию — anthropic:
ANTHROPIC_API_KEY=sk-ant-...
# Если в wrangler.toml AI_PROVIDER = "openai" (OpenAI / Gemini / DeepSeek / OpenRouter / Ollama…):
# AI_API_KEY=sk-...
# Если у повара свой провайдер (CHEF_PROVIDER):
# CHEF_API_KEY=...
